// Libs
#include <stdio.h> 
#include <string.h>

// Configurações e limites
#define MAX_ENCOMENDAS 100
#define META_FATURAMENTO 1000.00

// Molde de dados do pacote
typedef struct {
    int id;                 // ID unico
    int categoria;          // 1- Padrao, 2- Expressa, 3- Prioritaria
    int cupom;              // Codigo do cupom (se tiver)
    float peso;             // Em kg
    float distancia;        // Em km
    float valor_bruto;      // Frete cheio (sem desconto)
    float valor_final;      // O que o cliente realmente paga 
    char status[15];        // "ATIVA" ou "CANCELADA"
} typeOfencomenda;

// Vetor que segura tudo em memoria
typeOfencomenda encomendas[MAX_ENCOMENDAS]; 

// =========================================================================================================================================================
// VARIAVEIS GLOBAIS
// Mantem os totais da operacao rodando em memoria
// =========================================================================================================================================================

int total_encomendas = 0;   // Contador de pacotes que ja passaram
int qtd_padrao = 0;         
int qtd_expressa = 0;       
int qtd_prioritaria = 0;    
int qtd_isencoes = 0;       // Quantidade de fretes gratis concedidos

float faturamento_total = 0.0; // Grana total arrecadada
float soma_peso = 0.0;         // Base pra tirar media de peso
float soma_distancia = 0.0;    // Base pra tirar media de distancia
float maior_frete = 0.0;       // Rastreia a entrega mais cara
float menor_frete = 0.0;       // Rastreia a entrega mais barata

int pacote_atual = 0; // Indice auxiliar pro fluxo de cadastro

// =========================================================================================================================================================
// PROTOTIPOS DAS FUNCOES
// =========================================================================================================================================================

void programa();
void cadastro();
void registro();
void indicadores();
void listar_encomendas();
void buscar_por_id();
void cancelar_encomenda();
void exportar_relatorio();
void limpar_historico();
void processar_encomenda(int categoria, float peso, float distancia, int cupom);

int solicitar_cupom();
float calcular_taxa_peso(float peso);
int verificar_frete_gratis(int categoria, float peso, float distancia);

void salvar_arquivo();
void carregar_arquivo();
void recalcular_globais();

// Ponto de entrada
int main(int argc, char **argv)
{
    carregar_arquivo(); // Puxa os dados do txt antes de liberar o sistema
    programa();         // Roda o menu principal
    return 0;           
}

// Zera as globais e varre o array calculando tudo de novo (ignorando os cancelados)
void recalcular_globais()
{
    faturamento_total = 0.0;
    soma_peso = 0.0;
    soma_distancia = 0.0;
    qtd_padrao = 0;
    qtd_expressa = 0;
    qtd_prioritaria = 0;
    qtd_isencoes = 0;
    maior_frete = 0.0;
    menor_frete = 0.0;

    int primeiro_ativo = 1; // Flag pra pegar o primeiro valor base do maior/menor frete

    for (int i = 0; i < total_encomendas; i++) {
        if (strcmp(encomendas[i].status, "ATIVA") == 0) {
            faturamento_total += encomendas[i].valor_final;
            soma_peso += encomendas[i].peso;
            soma_distancia += encomendas[i].distancia;

            if (encomendas[i].categoria == 1) qtd_padrao++;
            else if (encomendas[i].categoria == 2) qtd_expressa++;
            else if (encomendas[i].categoria == 3) qtd_prioritaria++;

            // Se saiu de graca, contabiliza isencao
            if (encomendas[i].valor_final == 0.0) {
                qtd_isencoes++;
            }

            // Logica pra atualizar maior e menor frete dinamicamente
            if (primeiro_ativo) {
                maior_frete = encomendas[i].valor_final;
                menor_frete = encomendas[i].valor_final;
                primeiro_ativo = 0;
            } else {
                if (encomendas[i].valor_final > maior_frete) maior_frete = encomendas[i].valor_final;
                if (encomendas[i].valor_final < menor_frete) menor_frete = encomendas[i].valor_final;
            }
        }
    }
}

// Joga tudo pro .txt pra nao perder os dados se fechar o programa
void salvar_arquivo()
{
    FILE *arq = fopen("encomendas.txt", "w");
    if (arq == NULL) {
        printf("\nErro ao abrir arquivo para salvar!\n");
        return;
    }

    for (int i = 0; i < total_encomendas; i++) {
        fprintf(arq, "ID:%03d | TIPO:%d | PESO:%.2f | DIST:%.2f | CUPOM:%d | BRUTO:%.2f | FINAL:%.2f | STATUS:%s\n",
                encomendas[i].id,
                encomendas[i].categoria,
                encomendas[i].peso,
                encomendas[i].distancia,
                encomendas[i].cupom,
                encomendas[i].valor_bruto,
                encomendas[i].valor_final,
                encomendas[i].status);
    }

    fclose(arq);
}

// Lê o historico de encomendas.txt logo na inicializacao
void carregar_arquivo()
{
    FILE *arq = fopen("encomendas.txt", "r");
    if (arq == NULL) {
        return; // Arquivo ainda não existe, segue o jogo
    }

    total_encomendas = 0;

    while (total_encomendas < MAX_ENCOMENDAS) {
        typeOfencomenda e;
        // Parse da linha baseada no formato do fprintf
        int lidos = fscanf(arq, "ID:%d | TIPO:%d | PESO:%f | DIST:%f | CUPOM:%d | BRUTO:%f | FINAL:%f | STATUS:%14s\n",
                           &e.id, &e.categoria, &e.peso, &e.distancia, &e.cupom, &e.valor_bruto, &e.valor_final, e.status);
        
        if (lidos == 8) {
            encomendas[total_encomendas] = e;
            total_encomendas++;
        } else {
            break; // Fim do arquivo ou quebrou o padrão
        }
    }

    fclose(arq);
    recalcular_globais(); // Atualiza os contadores baseados no que veio do txt
}

// =========================================================================================================================================================
// MENU PRINCIPAL DO SISTEMA
// =========================================================================================================================================================
void programa()
{ 
    int opcao;

    for (;;) 
    {
        printf("=====================================================\n");
        printf("LOGTECH SGEF - VERSAO 2.0\n");
        printf("=====================================================\n");
        printf("1-Cadastrar e Processar Encomenda\n");
        printf("2-Listar Encomendas Registradas\n");
        printf("3-Buscar Encomendas por ID\n");
        printf("4-Cancelar Encomenda\n");
        printf("5-Exibir Resumo Estatistico e Indicadores\n");
        printf("6-Exportar Relatorio Diario (.txt)\n");
        printf("7-Limpar/Reiniciar Historico do Dia\n");
        printf("8-Sair\n");
        printf("=====================================================\n");
        printf("Escolha uma opcao: ");
        
        // Limpa o buffer pra evitar loop infinito se o cara digitar letra
        if (scanf("%d", &opcao) != 1) {
            printf("\nEntrada invalida!\n\n");
            while (getchar() != '\n'); 
            continue; 
        }

        switch (opcao)
        {
        case 1:
            // Trava pra nao estourar o tamanho do array
            if (total_encomendas >= MAX_ENCOMENDAS) {
                printf("\nLimite maximo de 100 encomendas atingido para hoje!\n\n");
            } else {
                cadastro(); 
            }
            break;

        case 2:
            listar_encomendas();
            break;

        case 3:
            buscar_por_id();
            break;

        case 4:
            cancelar_encomenda();
            break;

        case 5:
            registro();    
            indicadores(); 
            break;

        case 6:
            exportar_relatorio();
            break;

        case 7:
            limpar_historico();
            break;

        case 8:
            printf("\nSaindo do Sistema...\n");
            return; 

